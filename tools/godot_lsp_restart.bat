powershell -NoProfile -ExecutionPolicy Bypass -Command "$q=[char]34;$t=@(Get-CimInstance Win32_Process|?{$_.Name -like '*Godot*' -and $_.CommandLine -match '--lsp-port'});if($t.Count -eq 0){Write-Host '[LSP] no headless LSP process found (start it from VSCode, or the LSP is served by an open Godot editor)';exit 0};foreach($p in $t){$c=$p.CommandLine;if($c.StartsWith($q)){$exe=$c.Substring(1,$c.IndexOf($q,1)-1)}else{$exe=($c -split ' ')[0]};$pi=$c.IndexOf('--path ');$li=$c.IndexOf('--lsp-port ');if($pi -lt 0 -or $li -lt 0){Write-Host ('[LSP] PID {0}: cannot parse args, skipping' -f $p.ProcessId);continue};$qs=$c.IndexOf($q,$pi);$qe=$c.IndexOf($q,$qs+1);$proj=$c.Substring($qs+1,$qe-$qs-1);$port=($c.Substring($li+11) -split ' ')[0];Write-Host ('[LSP] stopping PID {0} (port {1})' -f $p.ProcessId,$port);Stop-Process -Id $p.ProcessId -Force;Start-Sleep -Milliseconds 600;Start-Process -FilePath $exe -ArgumentList @('--path',($q+$proj+$q),'--editor','--headless','--no-window','--lsp-port',$port) -WindowStyle Hidden;Start-Sleep -Milliseconds 800;Write-Host ('[LSP] restarted --path {0} --lsp-port {1}' -f $proj,$port)};Write-Host '[LSP] done (if VSCode does not reconnect, click Retry in the status bar)'"
